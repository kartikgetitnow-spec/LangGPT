# Node.js Express Backend Environment Template
PORT=5000
NODE_ENV=development

# Auth Token Verification (Must match frontend secret to decrypt/verify JWTs)
AUTH_SECRET="your_auth_secret_here"
NEXTAUTH_SECRET="your_nextauth_secret_here"

# Database & Cache Persistence Layer
DATABASE_URL="postgresql://user:password@localhost:5432/langgpt?schema=public"
REDIS_URL="redis://localhost:6379"

# AI Model Provider (Google Gemini via LangChain)
GOOGLE_API_KEY="your_gemini_api_key_here"
DEFAULT_AI_MODEL="gemini-2.5-flash-lite"
EMBEDDING_MODEL="models/gemini-embedding-001"
GEMINI_VOICE_MODEL="models/gemini-2.5-flash-preview-tts"
PROFILE_SYNTHESIZER_MODEL="gemini-2.5-flash-lite"

# Email SMTP for 6-Digit OTP Delivery (Optional dev fallback available)
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="LangGPT <no-reply@langgpt.com>"
