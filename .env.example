# ==============================================================================
# Frontend Next.js Environment Configuration (.env.example)
# ==============================================================================
BACKEND_URL="https://35.154.243.86.sslip.io"

# NextAuth / Auth.js (Frontend Client Authentication & OAuth)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your_nextauth_secret_here"
AUTH_SECRET="your_auth_secret_here"
AUTH_TRUST_HOST="true"

# PostgreSQL Database (used by NextAuth Prisma adapter on frontend)
DATABASE_URL="postgresql://user:password@localhost:5432/langgpt?schema=public"

# Google OAuth (Obtain from Google Cloud Console)
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# GitHub OAuth (Obtain from GitHub Developer Settings)
GITHUB_ID="your_github_client_id_here"
GITHUB_SECRET="your_github_client_secret_here"

# AI Model Configuration
GOOGLE_API_KEY="your_gemini_api_key_here"
DEFAULT_AI_MODEL="gemini-2.5-flash-lite"
EMBEDDING_MODEL="models/gemini-embedding-001"
GEMINI_VOICE_MODEL="models/gemini-2.5-flash-preview-tts"
PROFILE_SYNTHESIZER_MODEL="gemini-2.5-flash-lite"
